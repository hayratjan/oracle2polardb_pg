# ============================================================================
# Django 生产环境配置示例（复制为 .env 并按需修改）
# ============================================================================
# 环境标识：dev(默认) | prod
DJANGO_ENV=prod

# Django 密钥（生产必填，随机长字符串）
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# JWT 签名密钥（可选，默认复用 DJANGO_SECRET_KEY，建议独立）
# JWT_SIGNING_KEY=another-long-random-string

# 允许的域名（逗号分隔，生产必填）
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS 允许的前端域名（逗号分隔，生产必填）
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 连接密码 Fernet 加密（生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
MIGRATION_FERNET_KEY=

# Oracle Instant Client 路径（CI/无 Oracle 环境可留空；按实际安装路径修改,示例值仅供参考）
# ORACLE_CLIENT_LIB=/opt/oracle/instantclient_23_3

# 元数据库（可选，生产建议用 PostgreSQL 替代 SQLite）
# DATABASE_URL=postgres://user:pass@host:5432/migration_meta

# 文件系统浏览白名单（逗号分隔，生产必填，限制 BrowseDirectoriesAPIView 可访问的根目录）
# BROWSE_DIRECTORIES_WHITELIST=/data/migration,/tmp

# HTTPS 安全项（生产开启）
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# v2.4: 仅在反向代理后启用 SECURE_PROXY_SSL_HEADER
# 若 gunicorn 直接对外暴露(无 nginx/cdn),设 false 防止客户端伪造 X-Forwarded-Proto 绕过 HTTPS 校验
# 默认 true(假定前置反向代理)
USE_X_FORWARDED_PROTO=true

# v2.4: PostgreSQL 元数据库持久连接复用秒数(默认 60,设 0 关闭复用)
# DB_CONN_MAX_AGE=60

# Celery 异步任务与定时增量（Redis 示例）
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=true
MIGRATION_BEAT_SCAN_SECONDS=300

# Redis 密码（docker-compose 部署时必填,web/worker/beat 通过此密码连接 redis 服务）
REDIS_PASSWORD=changeme_redis

# Sentry 错误上报（仅生产环境启用，从 Sentry 项目设置获取 DSN）
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
